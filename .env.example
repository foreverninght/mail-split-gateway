MAIL_GATEWAY_ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
MAIL_GATEWAY_OPERATION_TIMEOUT_MS=60000
MAIL_GATEWAY_SESSION_KEEPALIVE_MS=240000
MAIL_GATEWAY_SESSION_MAINTENANCE_SCAN_MS=30000
MAIL_GATEWAY_DELIVERED_RETENTION_MS=1800000
MAIL_GATEWAY_UNUSED_TTL_MS=21600000
MAIL_GATEWAY_INACTIVE_TTL_MS=1800000
MAIL_GATEWAY_REGISTRATION_PROXY_REFRESH_MS=1800000
